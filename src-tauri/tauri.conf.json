{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "WeckPilot",
  "version": "1.1.4",
  "identifier": "com.alarmmaster.clock",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WeckPilot",
        "width": 700,
        "height": 650,
        "resizable": false,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "backgroundColor": [0, 0, 0, 0],
        "shadow": false,
        "alwaysOnTop": false,
        "visible": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © 2026 Norbert Jander",
    "publisher": "Norbert Jander",
    "macOS": {
      "signingIdentity": "Developer ID Application: Norbert Jander (TXF2V79Z6N)"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "helpers/WeckPilotWakeHelper.swift",
      "helpers/de.little-tools.weckpilot.wake-helper.plist",
      "helpers/install.sh",
      "helpers/uninstall.sh"
    ],
    "category": "Utility",
    "shortDescription": "WeckPilot – moderner Wecker mit Wochenprogramm",
    "longDescription": "WeckPilot ist eine moderne Wecker-Anwendung mit Digitalanzeige, mehreren Weckzeiten pro Tag, Wochenprogramm und progressiv ansteigender Lautstärke."
  }
}
